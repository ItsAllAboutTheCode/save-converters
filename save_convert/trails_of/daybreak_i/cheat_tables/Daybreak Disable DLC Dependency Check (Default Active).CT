<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Disable DLC Dependency Check"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : kuro.exe
  Version:
  Date   : 2026-01-16
  Author : SandwichSage

  This script disables the savedata DLC check as well as set all DLC flags to 0
  post load.
  Once the loaded file is saved again, the DLC check no longer needs to be enabled
  Side Effects: Marks all DLC as unobtained, so they can be obtained again via
  the DLC item menu

}

[ENABLE]

aobscanmodule(savefile_dlc_verification_aob,kuro.exe,75 44 48 8B 7C 24 30) // should be unique
alloc(newmem,$1000,savefile_dlc_verification_aob)

label(code)
label(memset_dlc_bitmap_loop)

newmem:

code:
  push rcx
  xor rcx rcx
memset_dlc_bitmap_loop:
  // loop over the dlc flags from the loaded savedata and set to 00
  // the dlc flags are stored as a bitmap.
  // There is a max of 1024 dlc flags with stored across 128 bytes(1024 / 8 bits)
  mov byte ptr [r15+rcx+001900F8],0
  inc rcx
  cmp rcx, 0x80 { 128 }
  jb memset_dlc_bitmap_loop
  pop rcx
  jmp kuro.exe+2F518F

savefile_dlc_verification_aob:
  jmp newmem
  nop 2

registersymbol(savefile_dlc_verification_aob)

[DISABLE]

savefile_dlc_verification_aob:
  db 75 44 48 8B 7C 24 30

unregistersymbol(savefile_dlc_verification_aob)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: kuro.exe+2F5149

kuro.exe+2F5128: 48 85 FF                          - test rdi,rdi
kuro.exe+2F512B: 75 03                             - jne kuro.exe+2F5130
kuro.exe+2F512D: 45 32 E4                          - xor r12b,r12b
kuro.exe+2F5130: 33 DB                             - xor ebx,ebx
kuro.exe+2F5132: FF C6                             - inc esi
kuro.exe+2F5134: 49 FF C6                          - inc r14
kuro.exe+2F5137: 40 D0 C5                          - rol bpl,1
kuro.exe+2F513A: 81 FE 00 04 00 00                 - cmp esi,00000400
kuro.exe+2F5140: 0F 82 2B FF FF FF                 - jb kuro.exe+2F5071
kuro.exe+2F5146: 45 84 E4                          - test r12b,r12b
// ---------- INJECTING HERE ----------
kuro.exe+2F5149: 75 44                             - jne kuro.exe+2F518F
// ---------- DONE INJECTING  ----------
kuro.exe+2F514B: 48 8B 7C 24 30                    - mov rdi,[rsp+30]
kuro.exe+2F5150: C7 87 10 08 19 00 0A 00 00 00     - mov [rdi+00190810],0000000A
kuro.exe+2F515A: BA 9F 85 FB 41                    - mov edx,41FB859F
kuro.exe+2F515F: 48 8D 0D DB 99 48 00              - lea rcx,[kuro.exe+77EB41]
kuro.exe+2F5166: E8 A5 A6 D3 FF                    - call kuro.exe+2F810
kuro.exe+2F516B: 8B D0                             - mov edx,eax
kuro.exe+2F516D: E8 BE FD FF FF                    - call kuro.exe+2F4F30
kuro.exe+2F5172: 48 63 87 CC 00 00 00              - movsxd  rax,dword ptr [rdi+000000CC]
kuro.exe+2F5179: 48 8D 0C 40                       - lea rcx,[rax+rax*2]
kuro.exe+2F517D: C7 84 8F 9C 00 00 00 0E 00 00 00  - mov [rdi+rcx*4+0000009C],0000000E
}
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
      <Description>"Disable Save Checksum"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : kuro.exe
  Version:

  This script skips the save checksum validation
}

[ENABLE]

aobscanmodule(disable_save_checksum_aob,kuro.exe,E9 71 01 00 00 83) // should be unique
alloc(newmem,$1000,disable_save_checksum_aob)

label(code)
label(return)

newmem:

code:
  // Skip over jump instruction to failed checksum logic
  jmp return

disable_save_checksum_aob:
  jmp newmem
return:
registersymbol(disable_save_checksum_aob)

[DISABLE]

disable_save_checksum_aob:
  db E9 71 01 00 00

unregistersymbol(disable_save_checksum_aob)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: kuro.exe+2A044B

kuro.exe+2A03FF: C7 80 1C 02 00 00 00 00 80 3F  - mov [rax+0000021C],3F800000
kuro.exe+2A0409: C7 80 14 02 00 00 00 00 80 3F  - mov [rax+00000214],3F800000
kuro.exe+2A0413: C7 80 18 02 00 00 00 00 80 3F  - mov [rax+00000218],3F800000
kuro.exe+2A041D: 48 89 B8 20 02 00 00           - mov [rax+00000220],rdi
kuro.exe+2A0424: 89 B8 28 02 00 00              - mov [rax+00000228],edi
