<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="42">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Disable DLC Dependency Check"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : kuro2.exe
  Version:
  Date   : 2026-01-16
  Author : SandwichSage

  This script disables the savedata DLC check as well as set all DLC flags to 0
  post load.
  Once the loaded file is saved again, the DLC check no longer needs to be enabled
  Side Effects: Marks all DLC as unobtained, so they can be obtained again via
  the DLC item menu
}

[ENABLE]

aobscanmodule(savefile_dlc_verification_aob,kuro2.exe,ED 75 59 C7 87 C4 22 40 00 0A 00 00 00) // should be unique
alloc(newmem,$1000,savefile_dlc_verification_aob)

label(code)
label(memset_dlc_bitmap_loop)

newmem:

code:
  push rcx
  xor rcx rcx
memset_dlc_bitmap_loop:
  // loop over the dlc flags from the loaded savedata and set to 00
  // the dlc flags are stored as a bitmap.
  // There is a max of 1024 dlc flags with stored across 128 bytes(1024 / 8 bits)
  mov byte ptr [r15+rcx+00270C38],0
  inc rcx
  cmp rcx, 0x80 { 128 }
  jb memset_dlc_bitmap_loop
  pop rcx
  jmp kuro2.exe+43416B

savefile_dlc_verification_aob+01:
  jmp newmem
  nop 7

registersymbol(savefile_dlc_verification_aob)

[DISABLE]

savefile_dlc_verification_aob+01:
  db 75 59 C7 87 C4 22 40 00 0A 00 00 00

unregistersymbol(savefile_dlc_verification_aob)
dealloc(newmem)

{
