</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
      <Description>"Disable Save Checksum"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : kuro2.exe
  Version:

  This script skips the save checksum validation
  The checksum is located at offset 0x8 within the decompressed user.dat file
  for a save
}

[ENABLE]

aobscanmodule(disable_save_checksum_aob,kuro2.exe,74 5C BB 03 00 00 00) // should be unique
alloc(newmem,$1000,disable_save_checksum_aob)

label(code)
label(return)

newmem:

code:
  jmp kuro2.exe+434026

disable_save_checksum_aob:
  jmp newmem
  nop 2
return:
registersymbol(disable_save_checksum_aob)

[DISABLE]

disable_save_checksum_aob:
  db 74 5C BB 03 00 00 00

unregistersymbol(disable_save_checksum_aob)
dealloc(newmem)

{
